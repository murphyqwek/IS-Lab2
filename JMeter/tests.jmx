            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Проверить отсутствие после успешного DELETE" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
int s=vars.get(&apos;scenario&apos;).toInteger()
def results=props.get(&apos;is_lab_results_&apos;+s).values()
boolean deleted=s==1 ? vars.get(&apos;operation&apos;)==&apos;delete&apos; &amp;&amp; results.any{it.operation==&apos;delete&apos; &amp;&amp; it.ok} : results.any{it.operation==&apos;delete&apos; &amp;&amp; it.ok}
String expected=deleted ? &apos;404&apos; : &apos;200&apos;
if(prev.responseCode!=expected) {
 AssertionResult.setFailure(true);AssertionResult.setFailureMessage(&apos;Ожидался GET &apos;+expected+&apos;, получен &apos;+prev.responseCode)
} else {
 prev.setSuccessful(true)
 if(!deleted &amp;&amp; s in [1,2]) {
   try {
    def data=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def prefix=vars.get(&apos;test_name&apos;)
    def allowed=s==2 ? [prefix+&apos;_USER1&apos;,prefix+&apos;_USER2&apos;] : [new groovy.json.JsonSlurper().parseText(vars.get(&apos;action_body&apos;)).name]
    if(!(data.name in allowed)) {AssertionResult.setFailure(true);AssertionResult.setFailureMessage(&apos;Итоговое name не соответствует отправленным данным&apos;)}
   } catch(Exception ex) {AssertionResult.setFailure(true);AssertionResult.setFailureMessage(&apos;Не удалось прочитать name из GET: &apos;+ex.message)}
 }
}
</stringProp>
