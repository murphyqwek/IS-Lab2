        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Подготовка и проверка настроек" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
try {
 assert ctx.getThreadGroup().getNumThreads()==2 : &apos;Сценарий 08 требует ровно два потока&apos;
 int index=ctx.getThreadNum()
 String run=props.get(&apos;is_lab_run&apos;)
 assert run : &apos;Включите служебную инициализацию&apos;
 def ids=[vars.get(&apos;event_update_id_1&apos;),vars.get(&apos;event_update_id_2&apos;)]
 assert ids.every { it?.isInteger() &amp;&amp; it.toInteger()&gt;0 } : &apos;Заполните event_update_id_1 и event_update_id_2&apos;
 assert ids[0].toInteger()!=ids[1].toInteger() : &apos;Нужны РАЗНЫЕ Event ID&apos;
 def users=new JsonSlurper().parseText(vars.get(&apos;users_json&apos;))
 assert users.size()&gt;=2 &amp;&amp; users[0].username!=users[1].username : &apos;Нужны два разных пользователя&apos;
 assert !vars.get(&apos;users_json&apos;).contains(&apos;FILL_&apos;) : &apos;Заполните users_json&apos;
 vars.put(&apos;login_body&apos;,JsonOutput.toJson(users[index]))
 vars.put(&apos;scenario&apos;,&apos;8&apos;);vars.put(&apos;operation&apos;,&apos;event_update&apos;)
 vars.put(&apos;test_name&apos;,&apos;JM_&apos;+run+&apos;_S8&apos;)
 vars.put(&apos;target_name&apos;,vars.get(&apos;test_name&apos;)+&apos;_EVENT&apos;)
 vars.put(&apos;target_id&apos;,ids[index])
 vars.put(&apos;action_path&apos;,vars.get(&apos;events_path&apos;)+&apos;/&apos;+ids[index])
 vars.put(&apos;action_method&apos;,vars.get(&apos;event_update_method&apos;))
 String raw=vars.get(&apos;event_update_json&apos;)?.trim()
 def body=new JsonSlurper().parseText(raw ? raw : vars.get(&apos;event_json&apos;))
 assert body instanceof Map &amp;&amp; !body.isEmpty() : &apos;Заполните JSON DTO события&apos;
 body.name=vars.get(&apos;target_name&apos;)
 vars.put(&apos;action_body&apos;,JsonOutput.toJson(body))
 SampleResult.setSuccessful(true);SampleResult.setResponseCode(&apos;200&apos;)
 SampleResult.setResponseData(&apos;Event ID=&apos;+ids[index]+&apos;; targetName=&apos;+vars.get(&apos;target_name&apos;),&apos;UTF-8&apos;)
} catch(Throwable ex) {
 SampleResult.setSuccessful(false);SampleResult.setResponseCode(&apos;CONFIG_ERROR&apos;)
 SampleResult.setResponseMessage(ex.message);SampleResult.setStopThread(true)
}</stringProp>
        </JSR223Sampler>
