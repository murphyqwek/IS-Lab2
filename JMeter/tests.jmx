          <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
int scenario = 4
 
try {
 int index = ctx.getThreadNum()
 String run = props.get(&apos;is_lab_run&apos;)
 assert run : &apos;Включите служебную группу 00&apos;
 def parse = { String key -&gt;
   def data = new JsonSlurper().parseText(vars.get(key))
   assert data instanceof Map &amp;&amp; !data.isEmpty() : &apos;Заполните &apos;+key+&apos; валидным JSON DTO&apos;
   data
 }
 def users = new JsonSlurper().parseText(vars.get(&apos;users_json&apos;))
 assert users.size() &gt;= 2 &amp;&amp; users[0].username != users[1].username : &apos;Нужны два разных пользователя&apos;
 assert !vars.get(&apos;users_json&apos;).contains(&apos;FILL_&apos;) : &apos;Заполните users_json&apos;
 vars.put(&apos;login_body&apos;,JsonOutput.toJson(users[index % users.size()]))
 vars.put(&apos;scenario&apos;,scenario.toString())
 vars.put(&apos;test_name&apos;,&apos;JM_&apos;+run+&apos;_S&apos;+scenario)
 String operation = scenario == 1 ? [&apos;create&apos;,&apos;update&apos;,&apos;delete&apos;,&apos;import&apos;][index] :
   scenario == 2 ? &apos;update&apos; : scenario == 3 ? (index == 0 ? &apos;update&apos; : &apos;delete&apos;) :
   scenario == 4 ? &apos;delete&apos; : scenario == 5 ? &apos;event&apos; : scenario == 6 ? &apos;venue&apos; : &apos;import&apos;
 vars.put(&apos;operation&apos;,operation)
 String idKey = scenario == 1 ? (operation == &apos;update&apos; ? &apos;crud_update_id&apos; : &apos;crud_delete_id&apos;) :
   scenario == 2 ? &apos;update_same_id&apos; : scenario == 3 ? &apos;update_delete_id&apos; : &apos;delete_same_id&apos;
 String id = vars.get(idKey)
 if (operation in [&apos;update&apos;,&apos;delete&apos;]) assert id?.isInteger() &amp;&amp; id.toInteger()&gt;0 : &apos;Заполните &apos;+idKey
 vars.put(&apos;target_id&apos;,id ?: &apos;&apos;)
 String path = vars.get(&apos;tickets_path&apos;)
 String method = &apos;POST&apos;
 def body = null
 switch(operation) {
 case &apos;create&apos;: body=parse(&apos;ticket_create_json&apos;); body.name=vars.get(&apos;test_name&apos;)+&apos;_CREATE&apos;; break
 case &apos;update&apos;: path+=&apos;/&apos;+id; method=vars.get(&apos;update_method&apos;); body=parse(&apos;ticket_update_json&apos;);body.name=vars.get(&apos;test_name&apos;)+&apos;_USER&apos;+(index+1);break
 case &apos;delete&apos;: path+=&apos;/&apos;+id;method=&apos;DELETE&apos;;break
 case &apos;event&apos;:path=vars.get(&apos;events_path&apos;);body=parse(&apos;event_json&apos;);body.name=vars.get(&apos;test_name&apos;)+&apos;_EVENT&apos;;break
 case &apos;venue&apos;:path=vars.get(&apos;venues_path&apos;);body=parse(&apos;venue_json&apos;);body.name=vars.get(&apos;test_name&apos;)+&apos;_VENUE&apos;;break
 case &apos;import&apos;:
   path=vars.get(&apos;import_path&apos;)
   String raw=vars.get(&apos;import_json&apos;)
   parse(&apos;import_json&apos;)
   assert raw.contains(&apos;@EVENT@&apos;) &amp;&amp; raw.contains(&apos;@VENUE@&apos;) : &apos;Добавьте @EVENT@ и @VENUE@ в имена объектов import_json&apos;
   raw=raw.replace(&apos;@EVENT@&apos;,vars.get(&apos;test_name&apos;)+&apos;_EVENT&apos;).replace(&apos;@VENUE@&apos;,vars.get(&apos;test_name&apos;)+&apos;_VENUE&apos;)
   def file=File.createTempFile(&apos;is-lab-import-&apos;,&apos;.json&apos;);file.setText(raw,&apos;UTF-8&apos;);file.deleteOnExit()
   vars.put(&apos;import_file&apos;,file.absolutePath)
   break
 }
 vars.put(&apos;action_path&apos;,path);vars.put(&apos;action_method&apos;,method)
 vars.put(&apos;action_body&apos;,body == null ? &apos;&apos; : JsonOutput.toJson(body))
 SampleResult.setSuccessful(true)
 SampleResult.setResponseData(&apos;Scenario &apos;+scenario+&apos; / &apos;+operation+&apos; / &apos;+vars.get(&apos;test_name&apos;),&apos;UTF-8&apos;)
} catch (Throwable ex) {
 SampleResult.setSuccessful(false);SampleResult.setResponseCode(&apos;CONFIG_ERROR&apos;)
 SampleResult.setResponseMessage(ex.message);SampleResult.setStopThread(true)
}
