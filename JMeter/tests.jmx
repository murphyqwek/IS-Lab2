          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSON или multipart из встроенного шаблона" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
import org.apache.jmeter.protocol.http.control.HeaderManager
import org.apache.jmeter.protocol.http.control.Header
import org.apache.jmeter.protocol.http.util.HTTPFileArg
def headers=new HeaderManager()
headers.add(new Header(&apos;Accept&apos;,&apos;application/json&apos;))
sampler.getArguments().removeAllArguments()
sampler.setHTTPFiles(new HTTPFileArg[0])
sampler.setDoMultipartPost(false);sampler.setPostBodyRaw(false)
if(vars.get(&apos;operation&apos;)==&apos;import&apos;) {
 sampler.setDoMultipartPost(true)
 sampler.setHTTPFiles([new HTTPFileArg(vars.get(&apos;import_file&apos;),vars.get(&apos;import_part&apos;),&apos;application/json&apos;)] as HTTPFileArg[])
} else if(vars.get(&apos;action_body&apos;)) {
 headers.add(new Header(&apos;Content-Type&apos;,&apos;application/json&apos;))
 sampler.addNonEncodedArgument(&apos;&apos;,vars.get(&apos;action_body&apos;),&apos;&apos;)
 sampler.setPostBodyRaw(true)
}
sampler.setHeaderManager(headers)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Старт" enabled="true">
