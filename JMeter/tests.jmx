          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def run = UUID.randomUUID().toString().substring(0,8)
props.put(&apos;is_lab_run&apos;,run)
(1..8).each { props.put(&apos;is_lab_results_&apos;+it, new java.util.concurrent.ConcurrentHashMap()) }
SampleResult.setResponseData(&apos;Run: &apos;+run,&apos;UTF-8&apos;)
SampleResult.setSuccessful(true)
</stringProp>
        </JSR223Sampler>
