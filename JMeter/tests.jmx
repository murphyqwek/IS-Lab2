        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Итог" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
int s=vars.get(&apos;scenario&apos;).toInteger()
def results=props.get(&apos;is_lab_results_&apos;+s)
int expected=ctx.getThreadGroup().getNumThreads()
def all=results.values().toList()
int success=all.count {it.ok}
boolean passed=all.size()==expected &amp;&amp; all.every {it.expected}
if(s in [5,6,7]) passed=passed &amp;&amp; success==1
if(s in [2,3,4]) passed=passed &amp;&amp; success&gt;=1
SampleResult.setSuccessful(passed)
SampleResult.setResponseCode(passed ? &apos;200&apos; : &apos;ASSERTION_FAILED&apos;)
SampleResult.setResponseData(groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson([
 scenario:s,marker:vars.get(&apos;test_name&apos;),responses:results,successCount:success,
 note:&apos;Проверены HTTP-ответы. Уникальность и откат подтвердите в БД. Два успешных UPDATE не доказывают lost update.&apos;
])), &apos;UTF-8&apos;)
</stringProp>
