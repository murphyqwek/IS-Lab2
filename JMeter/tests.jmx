          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Сохранить ответы для общего итога" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
def code=prev.responseCode
boolean ok=code ==~ /2\d\d/
def allowed=vars.get(&apos;conflict_codes&apos;).split(&apos;,&apos;).collect {it.trim()}
int s=vars.get(&apos;scenario&apos;).toInteger()
boolean expected=ok || (s!=1 &amp;&amp; (allowed.contains(code) || (s in [3,4] &amp;&amp; code==&apos;404&apos;)))
prev.setSuccessful(expected)
props.get(&apos;is_lab_results_&apos;+s).put(ctx.getThreadNum(),[code:code,ok:ok,expected:expected,operation:vars.get(&apos;operation&apos;)])
if(ok &amp;&amp; vars.get(&apos;operation&apos;)==&apos;create&apos;) {
 try { vars.put(&apos;target_id&apos;,new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).id.toString()) }
 catch(Exception ignored) { log.warn(&apos;Не удалось извлечь id созданного Ticket: проверьте формат ответа&apos;) }
}
if(vars.get(&apos;import_file&apos;)) new File(vars.get(&apos;import_file&apos;)).delete()
</stringProp>
