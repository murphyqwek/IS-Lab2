        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSON или multipart из встроенного шаблона" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
import org.apache.jmeter.protocol.http.control.HeaderManager
import org.apache.jmeter.protocol.http.control.Header
import org.apache.jmeter.protocol.http.util.HTTPFileArg
def headers=new HeaderManager()
headers.add(new Header(&apos;Accept&apos;,&apos;application/json&apos;))
sampler.getArguments().removeAllArguments()
sampler.setHTTPFiles(new HTTPFileArg[0])
sampler.setDoMultipartPost(false);sampler.setPostBodyRaw(false)
if(vars.get(&apos;operation&apos;)==&apos;import&apos;) {
 sampler.setDoMultipartPost(true)
 sampler.setHTTPFiles([new HTTPFileArg(vars.get(&apos;import_file&apos;),vars.get(&apos;import_part&apos;),&apos;application/json&apos;)] as HTTPFileArg[])
} else if(vars.get(&apos;action_body&apos;)) {
 headers.add(new Header(&apos;Content-Type&apos;,&apos;application/json&apos;))
 sampler.addNonEncodedArgument(&apos;&apos;,vars.get(&apos;action_body&apos;),&apos;&apos;)
 sampler.setPostBodyRaw(true)
}
sampler.setHeaderManager(headers)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Старт" enabled="true">
            <intProp name="groupSize">0</intProp>
            <longProp name="timeoutInMs">30000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Сохранить ответы для общего итога" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
def code=prev.responseCode
boolean ok=code ==~ /2\d\d/
def allowed=vars.get(&apos;conflict_codes&apos;).split(&apos;,&apos;).collect {it.trim()}
int s=vars.get(&apos;scenario&apos;).toInteger()
boolean expected=ok || (s!=1 &amp;&amp; (allowed.contains(code) || (s in [3,4] &amp;&amp; code==&apos;404&apos;)))
prev.setSuccessful(expected)
props.get(&apos;is_lab_results_&apos;+s).put(ctx.getThreadNum(),[code:code,ok:ok,expected:expected,operation:vars.get(&apos;operation&apos;)])
if(ok &amp;&amp; vars.get(&apos;operation&apos;)==&apos;create&apos;) {
 try { vars.put(&apos;target_id&apos;,new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).id.toString()) }
 catch(Exception ignored) { log.warn(&apos;Не удалось извлечь id созданного Ticket: проверьте формат ответа&apos;) }
}
if(vars.get(&apos;import_file&apos;)) new File(vars.get(&apos;import_file&apos;)).delete()
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Итог" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
int s=vars.get(&apos;scenario&apos;).toInteger()
def results=props.get(&apos;is_lab_results_&apos;+s)
int expected=ctx.getThreadGroup().getNumThreads()
def all=results.values().toList()
int success=all.count {it.ok}
boolean passed=all.size()==expected &amp;&amp; all.every {it.expected}
if(s in [5,6,7,8]) passed=passed &amp;&amp; success==1
if(s in [2,3,4]) passed=passed &amp;&amp; success&gt;=1
SampleResult.setSuccessful(passed)
SampleResult.setResponseCode(passed ? &apos;200&apos; : &apos;ASSERTION_FAILED&apos;)
SampleResult.setResponseData(groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson([
 scenario:s,marker:vars.get(&apos;test_name&apos;),responses:results,successCount:success,
 targetName:vars.get(&apos;target_name&apos;), note:&apos;Ровно один PUT должен быть успешным. Далее проверяются имена обоих Event; дополнительно проверьте уникальность SQL-запросом.&apos;
])), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Финиш" enabled="true">
            <intProp name="groupSize">0</intProp>
            <longProp name="timeoutInMs">30000</longProp>
          </SyncTimer>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Event после переименования">
          <intProp name="HTTPSampler.connect_timeout">10000</intProp>
          <intProp name="HTTPSampler.response_timeout">30000</intProp>
          <stringProp name="HTTPSampler.domain">${host}</stringProp>
          <stringProp name="HTTPSampler.port">${port}</stringProp>
          <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">${action_path}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Успешный Event переименован, отклонённый сохранил имя" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">try {
 assert prev.responseCode==&apos;200&apos; : &apos;Итоговый Event недоступен: HTTP &apos;+prev.responseCode
 def data=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
 def result=props.get(&apos;is_lab_results_8&apos;).get(ctx.getThreadNum())
 assert result!=null : &apos;Нет результата PUT&apos;
 String expected=result.ok ? vars.get(&apos;target_name&apos;) : vars.get(&apos;original_event_name&apos;)
 assert data.name==expected : &apos;Ожидалось имя &apos;+expected+&apos;, получено &apos;+data.name
} catch(Throwable ex) {
 AssertionResult.setFailure(true);AssertionResult.setFailureMessage(ex.message)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
